# ---------- Mode ----------
# mock = no API keys needed; fake voice and video made locally with FFmpeg
# live = call the real AI providers (set the keys below)
AYIKO_PROVIDER_MODE=mock

# ---------- Video (fal.ai) ----------
FAL_KEY=
# Any fal image-to-video endpoint; swap models without code changes
FAL_I2V_MODEL=fal-ai/kling-video/v2.1/standard/image-to-video

# ---------- Voice: English, French, Hausa, Swahili ----------
ELEVENLABS_API_KEY=
ELEVENLABS_MODEL=eleven_v3
ELEVENLABS_VOICE_FEMALE=21m00Tcm4TlvDq8ikWAM
ELEVENLABS_VOICE_MALE=JBFqnCBsd6RMkjVDRZzb

# ---------- Voice: Twi, Ga, Ewe, Yoruba (GhanaNLP Khaya) ----------
KHAYA_API_KEY=
KHAYA_BASE_URL=https://translation-api.ghananlp.org
KHAYA_TTS_PATH=/tts/v2/synthesize

# ---------- Voice: Yoruba, Igbo, Hausa, Pidgin (9jaLingo) ----------
NAIJALINGO_API_KEY=
NAIJALINGO_BASE_URL=https://api.9jalingo.org

# ---------- Storage ----------
# local = files under LOCAL_STORAGE_DIR; r2 = Cloudflare R2
STORAGE=local
LOCAL_STORAGE_DIR=./.ayiko-storage
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=ayiko-media

# ---------- Database (Supabase) ----------
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ---------- Rendering ----------
CAPTION_FONT=Inter
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
