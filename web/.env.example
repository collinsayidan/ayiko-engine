# Set these in Vercel: Project → Settings → Environment Variables
# (and in web/.env.local to run the site on your computer).
NEXT_PUBLIC_SITE_URL=https://ayiko.ai

# Supabase → Project Settings → API Keys
NEXT_PUBLIC_SUPABASE_URL=
# The "publishable" key (sb_publishable_…) or legacy "anon" key: safe in the browser
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# The "secret" key (sb_secret_…) or legacy "service_role" key: server only, never share it
SUPABASE_SECRET_KEY=

# Stripe → Developers → API keys (secret key) and → Webhooks (signing secret)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Script assistant (drafting + translation): Anthropic → console.anthropic.com → API keys
ANTHROPIC_API_KEY=
# Optional: GhanaNLP key for Twi/Yoruba/Ewe/Ga translation (same key as the worker's)
KHAYA_API_KEY=

# Admin dashboard at /admin: comma-separated emails allowed in
ADMIN_EMAILS=collinsayidan@gmail.com
