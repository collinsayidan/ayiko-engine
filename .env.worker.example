# Render worker settings. On the server: cp .env.worker.example .env.worker && nano .env.worker
# Never commit .env.worker. It holds secret keys.

AYIKO_PROVIDER_MODE=live
STORAGE=supabase

# Supabase → Project Settings → API Keys (use the SECRET key, not the publishable one)
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# fal.ai → Dashboard → Keys
FAL_KEY=
FAL_I2V_MODEL=fal-ai/kling-video/v2.1/standard/image-to-video

# ElevenLabs → Profile → API keys (English, French, Swahili; Hausa backup)
ELEVENLABS_API_KEY=
ELEVENLABS_MODEL=eleven_v3
ELEVENLABS_VOICE_FEMALE=21m00Tcm4TlvDq8ikWAM
ELEVENLABS_VOICE_MALE=JBFqnCBsd6RMkjVDRZzb

# GhanaNLP developer portal → Profile → subscription key (Twi, Ewe, Ga; Yoruba backup)
KHAYA_API_KEY=

# 9jaLingo (Yoruba, Pidgin, Hausa, Igbo). Optional: Pidgin needs it.
NAIJALINGO_API_KEY=

# How many videos one server makes at once (4 vCPU / 8 GB: 2–3)
WORKER_CONCURRENCY=2

# Moderation for scripts and photos: OpenAI's free omni-moderation model (platform.openai.com → API keys). Optional; basic rules apply without it.
OPENAI_API_KEY=

# "Your video is ready" emails via Resend (resend.com → API Keys). Needs a verified sending domain (e.g. ayiko.ai).
RESEND_API_KEY=
EMAIL_FROM=Ayiko <hello@ayiko.ai>
SITE_URL=https://ayiko-engine.vercel.app
